# Local development defaults. Copy to .env and replace SECRET_KEY with a local secret.
SECRET_KEY=replace-with-a-local-development-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# DevEdu's HTTPS proxy uses app subdomains while Django runs locally over HTTP.
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://0.0.0.0:3000,https://*.lab.devedu.io

# Local SQLite database URL; the path is relative to the project root.
DATABASE_URL=sqlite:///db.sqlite3

# Render: configure DATABASE_URL in the service environment with the PostgreSQL
# connection URL provided by Render. Do not commit database credentials here.
